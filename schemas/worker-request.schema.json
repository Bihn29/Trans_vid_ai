{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietdub.local/schemas/worker-request.schema.json",
  "title": "Worker request protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "action",
    "project_id",
    "input",
    "config",
    "output_directory"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "input": { "type": "object" },
    "config": { "type": "object" },
    "output_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}

