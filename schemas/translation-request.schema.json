{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietdub.local/schemas/translation-request.schema.json",
  "title": "Translation block request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_language", "target_language", "segments", "context_before", "context_after", "glossary", "locked_names"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_language": { "type": "string", "minLength": 2, "maxLength": 32 },
    "target_language": { "type": "string", "minLength": 2, "maxLength": 32 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/segment" }
    },
    "context_before": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/segment" } },
    "context_after": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/segment" } },
    "glossary": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_text", "target_text", "case_sensitive"],
        "properties": {
          "source_text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "target_text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "case_sensitive": { "type": "boolean" }
        }
      }
    },
    "locked_names": { "type": "array", "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_text"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "source_text": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    }
  }
}
