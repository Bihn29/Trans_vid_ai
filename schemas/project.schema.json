{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietdub.local/schemas/project.schema.json",
  "title": "VietDub project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "status", "source_language", "target_language", "workflow_mode", "config_snapshot", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["draft", "active", "paused", "completed", "failed", "cancelled"] },
    "source_language": { "type": "string", "minLength": 2, "maxLength": 16 },
    "target_language": { "type": "string", "minLength": 2, "maxLength": 16 },
    "workflow_mode": { "enum": ["subtitles", "dubbed"] },
    "source_asset_id": { "type": ["string", "null"], "format": "uuid" },
    "config_snapshot": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

